# Copy this file to .env and fill in what you have.
# Keys here are only used to seed the app the first time it starts
# (and by `npm run check:mirakl`). After that, edit them in the app under Channels.

PORT=4300
# Public address people use to open the app. Used to build the Google Calendar subscribe link.
APP_URL=http://localhost:4300
# Timezone used to decide which calendar day a Mirakl promotion starts/ends on
CALENDAR_TZ=America/New_York
# Auto-sync Mirakl every N hours (0 = off, sync manually from the app)
SYNC_EVERY_HOURS=6

# Mirakl seller accounts — base URL is the marketplace's Mirakl instance (e.g. https://xxxx-prod.mirakl.net)
# API key: in each Mirakl back office, My user settings > API key
MIRAKL_NORDSTROM_URL=
MIRAKL_NORDSTROM_KEY=
MIRAKL_NORDSTROM_SHOP_ID=

MIRAKL_MACYS_URL=
MIRAKL_MACYS_KEY=
MIRAKL_MACYS_SHOP_ID=

MIRAKL_KOHLS_URL=
MIRAKL_KOHLS_KEY=
MIRAKL_KOHLS_SHOP_ID=

MIRAKL_JCPENNEY_URL=
MIRAKL_JCPENNEY_KEY=
MIRAKL_JCPENNEY_SHOP_ID=

MIRAKL_DEBENHAMS_URL=
MIRAKL_DEBENHAMS_KEY=
MIRAKL_DEBENHAMS_SHOP_ID=
